# Copy to .env. The DevContainer passes it to the container with --env-file,
# and mise loads it on the host.

GITHUB_PERSONAL_ACCESS_TOKEN=

# SonarQube CLI (`sonar`), used by the sonarqube plugin's `sonar api` skill.
# SONARQUBE_CLI_ORG is needed for SonarQube Cloud only.
SONARQUBE_CLI_URL=https://sonarcloud.io
SONARQUBE_CLI_ORG=
SONARQUBE_CLI_TOKEN=

# Optional `wiki` settings; the tests set their own.
# Where wikis.toml (the wiki registry) lives:
# LLM_WIKI_HOME=
# Extra wiki directories, separated by the platform path separator:
# LLM_WIKI_PATH=
# The claude binary to run, if not `claude` on PATH:
# LLM_WIKI_CLAUDE=
