#!/usr/bin/env python3
"""Scripted stand-in for `claude -p`. Stdlib only, so it cannot import llm_wiki.

Env: FAKE_CLAUDE_QUEUE (JSON list of responses, popped per call), FAKE_CLAUDE_LOG (JSONL of
invocations), FAKE_CLAUDE_VERSION, FAKE_CLAUDE_HELP, FAKE_CLAUDE_VERSION_EXIT, FAKE_CLAUDE_HELP_EXIT,
FAKE_CLAUDE_VERSION_SLEEP. Response keys: stdout (dict or str), stderr, exit, sleep,
write ({path: text}, relative to cwd; absolute paths are written as given),
echo_canary (put the canary word from cwd/CLAUDE.md into stdout.structured_output.canary),
echo_token (put the token from the system prompt file into structured_output.token),
write_abs_from_prompt (write "ok" to the first absolute path found in stdin).
"""
import json
import os
import re
import sys
import time

LOGGED_ENV = (
    "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT",
    "CLAUDE_CODE_OAUTH_TOKEN", "CLAUDE_CODE_DISABLE_AUTO_MEMORY",
)
STUB_HELP = "--output-format\n--model\n--system-prompt-file\n--tools\n--max-budget-usd\n"

argv = sys.argv[1:]
if argv == ["--version"]:
    time.sleep(float(os.environ.get("FAKE_CLAUDE_VERSION_SLEEP", "0")))
    print(os.environ.get("FAKE_CLAUDE_VERSION", "2.1.310 (Claude Code)"))
    sys.exit(int(os.environ.get("FAKE_CLAUDE_VERSION_EXIT", "0")))
if argv == ["--help"]:
    print(os.environ.get("FAKE_CLAUDE_HELP", STUB_HELP))
    sys.exit(int(os.environ.get("FAKE_CLAUDE_HELP_EXIT", "0")))

stdin = sys.stdin.read()
system_prompt = None
if "--system-prompt-file" in argv:
    with open(argv[argv.index("--system-prompt-file") + 1], encoding="utf-8") as fh:
        system_prompt = fh.read()
cwd = os.getcwd()
with open(os.environ["FAKE_CLAUDE_LOG"], "a", encoding="utf-8") as fh:
    fh.write(json.dumps({
        "argv": argv, "stdin": stdin, "cwd": cwd, "listdir": sorted(os.listdir(cwd)),
        "env": {k: os.environ.get(k) for k in LOGGED_ENV}, "system_prompt": system_prompt,
    }) + "\n")

queue_path = os.environ["FAKE_CLAUDE_QUEUE"]
with open(queue_path, encoding="utf-8") as fh:
    queue = json.load(fh)
if not queue:
    print("fake claude: queue empty", file=sys.stderr)
    sys.exit(3)
resp = queue.pop(0)
with open(queue_path, "w", encoding="utf-8") as fh:
    json.dump(queue, fh)

if resp.get("sleep"):
    time.sleep(resp["sleep"])
for rel, text in resp.get("write", {}).items():
    path = os.path.join(cwd, rel)  # join keeps an absolute rel as is
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(text)
if resp.get("write_abs_from_prompt"):
    m = re.search(r"/[^\s]+", stdin)
    if m:
        with open(m.group(0), "w", encoding="utf-8") as fh:
            fh.write("ok")
out = resp.get("stdout", "")
if resp.get("echo_canary"):
    with open(os.path.join(cwd, "CLAUDE.md"), encoding="utf-8") as fh:
        word = re.search(r"canary word is (\S+?)\.", fh.read()).group(1)
    out = dict(out, structured_output=dict(out.get("structured_output") or {}, canary=word))
if resp.get("echo_token"):
    word = re.search(r"token is (\S+?)[;.\s]", system_prompt).group(1)
    out = dict(out, structured_output=dict(out.get("structured_output") or {}, token=word))
sys.stdout.write(out if isinstance(out, str) else json.dumps(out))
sys.stderr.write(resp.get("stderr", ""))
sys.exit(resp.get("exit", 0))
