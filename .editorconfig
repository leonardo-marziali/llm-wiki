# EditorConfig is awesome: https://EditorConfig.org
# Complete list of properties: https://github.com/editorconfig/editorconfig/wiki/EditorConfig-Properties

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# Ruff's line-length in pyproject.toml
[*.py]
indent_size = 4
max_line_length = 88

[*.toml]
indent_size = 4

# Prettier's printWidth in .prettierrc.json
[*.md]
max_line_length = 80
